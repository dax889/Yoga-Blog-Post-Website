<%- include('../partials/head') %>

  <body>
    <%- include('../partials/nav') %>

    <h1 class="p-6 text-2xl font-semibold text-gray-700 text-center">Here are your favourites:</h1>
      <% if (!favouritehome || favouritehome.length === 0) { %>
        <p class="text-center text-gray-500 mt-10">No registered homes yet.</p>
      <% } else { %>


        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 p-6">
          <% favouritehome.forEach(home => { %>
            <li class="bg-neutral-primary-soft block max-w-sm p-6 rounded-base shadow-lg border-4 border-indigo-300 hover:border-indigo-500 hover:shadow-xl transition duration-300">

              <!-- Profile Image -->
              <div class="flex justify-center mb-4">
                <img
                  src="/uploads/<%= home.file %>"
                  alt="Profile Image"
                  class="rounded-base object-cover w-60 h-50"
                >
              </div>

              <!-- User Info -->
              <div class="space-y-2">
                <h2 class="text-2xl text-heading font-semibold tracking-tight">
                  <%= home.username %>
                </h2>

                <p class="text-gray-500">
                  <%= home.email %>
                </p>

                <p class="text-gray-600">
                  📍 <%= home.location %>
                </p>

                <div class="flex items-center justify-between mt-6">
                  <p class="text-3xl font-extrabold text-heading">
                    ₹ <%= home.price %> /night
                  </p>

                  <p class="text-amber-500 font-semibold">
                    ⭐ Rating: <%= home.service_rating %>/5
                  </p>
                </div>
              </div>

            </li>
          <% }) %>
        </ul>

      <% } %>

        </ul>


        <main class="rounded-lg border-2 border-blue-500 m-4 p-10 text-center">
          <h1 class="text-blue-500 text-5xl underline hover:text-blue-400">
            <a href="/contact-us">Contact Us</a>
          </h1>
        </main>
  </body>

  </html>