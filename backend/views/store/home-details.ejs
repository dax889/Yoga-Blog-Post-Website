<%- include('../partials/head') %>

  <body>
    
    <%- include('../partials/nav') %>
    <h1 class="p-6 text-2xl font-semibold text-gray-700 text-center">Here are in home detail page and Id is <%=homeId %></h1>
              <div class="flex item-center justify-center min-h-screen bg-slate-100">
        <!--Card Container-->
        <div class="flex flex-col p-6 space-y-10 rounded-2xl shadow-2xl bg-white 
        md:flex-row md:space-y-0 md:space-x-10 md:m-0 md:p-auto md:my-auto">
            <!--image div-->
            <div>
                <img src="/uploads/<%= home.file %>"
                    alt="Profile Image" class="mx-auto duration-200 w-96 hover:scale-105">
            </div>
            <!--content-->
            <div class="flex flex-col space-y-6">
                <!--Label Description -->
                <div class="flex flex-col mb-4 space-y-3 text-center md:text-left">
                    <div>
                        <div class="inline-block px-3 py-1 text-sm text-white bg-black rounded-full">
                            Free Shipping
                        </div>
                    </div>
                    <!--Title-->
                    <div class="max-w-sm text-2xl font-bold">
                         <%= home.username %>
                    </div>
                    <div class="max-w-sm text-xl font-semibold text-gray-500">
                       <%= home.email %>

                    </div>
                    <!-- Price Container -->
                    <div class="flex flex-col mb-4 space-y-3 text-center md:text-left">
                        <div>
                            <p class="text-4xl font-bold">₹ <%= home.price %> /night</p>
                            <p class="text-sm text-green-600 font-bold">inclusive of all taxes</p>
                        </div>
                        <p class="text-sm font-light text-gray-500 font-medium">
                            ⭐ Rating: <%= home.service_rating %>/5
                        </p>
                    </div>
                    <!-- Button Group -->
                    <div class="group">
                        <button
                            class="w-full transition-all duration-150 bg-blue-700 text-white border-b-8 border-b-blue-700 rounded-lg group-hover:border-t-8 group-hover:border-b-0 group-hover:bg-blue-700 group-hover:border-t-blue-700 group-hover:shadow-lg">
                            <div
                                class="px-8 py-4 duration-150 bg-blue-500 rounded-lg group-hover:bg-blue-700 font-semibold">
                                Book
                            </div>
                        </button>
                    </div>

                    <!-- Bottom Buttons Container -->
                    <div class="flex flex-col space-y-4 md:space-y-0 md:space-x-4 md:flex-row">
                        <button
                            class="flex items-center justify-center py-3 px-5 space-x-3 border-2 border-gray-300 rounded-lg shadow-sm hover:bg-opacity-30 hover:shadow-2lg hover:-translate-y-0.5 transition-all duration-150 hover:border-gray-500">
